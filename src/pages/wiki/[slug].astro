---
import Base from '../../layouts/Base.astro';
import StubBanner from '../../components/StubBanner.astro';
import LocalSky from '../../components/LocalSky.astro';
import {
  loadAllArticles,
  getArticleBySlug,
  getIncomingLinks,
  getInboundLinkCount,
  getInfoboxAsPairs,
  resolveWikilink,
  slugify,
  humanizeType,
  isStub,
} from '../../lib/vault';

export async function getStaticPaths() {
  const articles = loadAllArticles();
  return articles.map(a => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = getArticleBySlug(slug!);
const BASE_URL = import.meta.env.BASE_URL;
if (!article) {
  return Astro.redirect(`${BASE_URL}missing?title=` + encodeURIComponent(slug || ''));
}

const isGreeneLesson = article.tags.includes('greene-semester') && article.tags.includes('lesson');
const infoboxPairs = getInfoboxAsPairs(article);
const incoming = getIncomingLinks(article.slug).slice(0, 12); // capped: feeds LocalSky + lesson what-links-here
const backlinkCount = getInboundLinkCount(article.slug); // true count for the meta line
const hasPortraitInfobox = article.type === 'person' || article.type === 'figure';

const skyNeighbors = incoming.map(a => ({ slug: a.slug, title: a.title, journal: a.type === 'journal' || a.type === 'voice-memo' }));
const readMinutes = Math.max(1, Math.round(((article.html || '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length) / 220));
const isStubArticle = isStub(article);

const editSubject = encodeURIComponent(`[cc:Mac] WikiLeighs edit: ${article.title}`);
const editBody = encodeURIComponent(
  `Page: ${article.title}\nSlug: ${article.slug}\nSource: notes/${article.relPath || ''}\n\nSuggested change:\n\n(describe what you'd like updated)\n\n— Sent from WikiLeighs`
);
const editMailto = `mailto:leigh.llewelyn@gmail.com?subject=${editSubject}&body=${editBody}`;

function initialsFor(title: string) {
  const parts = title.split(/\s+/).filter(Boolean);
  if (parts.length === 1) return parts[0][0]?.toUpperCase() || 'L';
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function renderInfoboxValue(key: string, raw: string): string {
  if (key === 'tags') {
    return raw.split(/,\s*/).map(t => `<span class="tag-chip">${escapeHtml(t)}</span>`).join(' ');
  }
  if (key === 'related') {
    return raw.split(/,\s*/).map(t => {
      const cleaned = t.replace(/^\[\[/, '').replace(/\]\]$/, '').split('|')[0].trim();
      const res = resolveWikilink(cleaned);
      if (res) return `<a href="${import.meta.env.BASE_URL}wiki/${res.slug}">${escapeHtml(cleaned)}</a>`;
      return `<span class="wikilink-broken" style="color: var(--color-link-broken);">${escapeHtml(cleaned)}</span>`;
    }).join(', ');
  }
  if (key === 'source' && /^https?:\/\//i.test(raw)) {
    return `<a href="${raw}" target="_blank" rel="noopener noreferrer">${escapeHtml(raw.replace(/^https?:\/\//, '').slice(0, 40))}</a>`;
  }
  return escapeHtml(raw);
}

function escapeHtml(s: string): string {
  return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
}
---
<Base title={article.title} description={article.firstParagraph || article.title} activeType={article.type}>
  {isGreeneLesson ? (
    <Fragment>
      {/* Greene Semester lessons keep their dedicated print layout untouched.
          The suggest-edit line lives OUTSIDE the lesson subtree (the old
          shared tabs bar carried this affordance before the redesign). */}
      <div class="room-meta"><a class="suggest" href={editMailto}>✎ suggest edit</a></div>
      <article class="article-body greene-lesson">
        <StubBanner article={article} />
        {article.photo && !hasPortraitInfobox && (
          <figure class="today-hero">
            <img src={article.photo} alt={article.title} loading="lazy" />
          </figure>
        )}
        <Fragment set:html={article.html} />
      </article>
      {incoming.length > 0 && (
        <section style="margin-top: 1.5rem; border-top: 1px solid var(--color-border-light); padding-top: 0.7rem;">
          <h2 style="font-family: var(--font-serif); font-weight: 400; font-size: 1.15rem; margin-bottom: 0.4rem;">What links here</h2>
          <ul style="list-style: disc; margin-left: 1.35rem; font-size: 0.9rem; columns: 2; column-gap: 1.5rem;">
            {incoming.map(i => <li style="break-inside: avoid;"><a href={`${BASE_URL}wiki/${i.slug}`} style="color: var(--color-link); text-decoration: none;">{i.title}</a> <span style="color: var(--color-muted); font-style: italic;">— {humanizeType(i.type)}</span></li>)}
          </ul>
        </section>
      )}
    </Fragment>
  ) : (
    <article class="room">
      <div class="room-main">
        <div class="pills">
          <a class="pill gold" href={`${BASE_URL}category/${article.type}`}>{article.type}</a>
          {article.tags.slice(0, 4).map(t => <a class="pill" href={`${BASE_URL}tag/${slugify(t)}`}>{t}</a>)}
        </div>
        <h1 class="room-title">{article.title}</h1>
        <div class="room-meta">
          updated <span class="verd">{article.updated || article.created || '—'}</span>
          · {backlinkCount} backlinks · {readMinutes} min ·
          <a class="suggest" href={editMailto}>✎ suggest edit</a>
        </div>
        {isStubArticle && <StubBanner article={article} />}
        {article.photo && !hasPortraitInfobox && (
          <figure class="today-hero">
            <img src={article.photo} alt={article.title} loading="lazy" />
          </figure>
        )}
        <div class="article-body" set:html={article.html} />
        <LocalSky neighbors={skyNeighbors} />
      </div>
      <aside class="room-side">
        {(infoboxPairs.length > 0 || hasPortraitInfobox) && (
          <div class="dossier">
            <div class="dossier-title">Dossier</div>
            {hasPortraitInfobox && (
              <div class="dossier-portrait">
                {article.photo ? (
                  <img
                    src={article.photo}
                    alt={article.title}
                    loading="lazy"
                    class="rounded-full object-cover aspect-square person-photo"
                    onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'silver-circle',textContent:this.dataset.initials}))"
                    data-initials={initialsFor(article.title)}
                  />
                ) : (
                  <span class="silver-circle">{initialsFor(article.title)}</span>
                )}
              </div>
            )}
            {infoboxPairs.length > 0 && (
              <dl>
                {infoboxPairs.map(p => (
                  <Fragment>
                    <dt>{p.key}</dt>
                    <dd set:html={renderInfoboxValue(p.key, p.value)} />
                  </Fragment>
                ))}
              </dl>
            )}
          </div>
        )}
        {article.toc.length > 1 && (
          <nav class="otp" aria-label="On this page">
            <div class="otp-title">On this page</div>
            {article.toc.map(h => <a href={`#${h.id}`} class={`d${h.level}`}>{h.text}</a>)}
          </nav>
        )}
      </aside>
    </article>
  )}
</Base>
