---
import Base from '../layouts/Base.astro';
import {
  getStubs,
  getOrphans,
  getBrokenWikilinks,
  getStaleActiveProjects,
  humanizeType,
  loadAllArticles,
} from '../lib/vault';

// Full lists for true totals — the homepage status line shows the same
// numbers and they must match. Panels render only the top 30 of each.
const stubsAll = getStubs(10_000);
const orphansAll = getOrphans(10_000);
const brokenAll = getBrokenWikilinks(10_000);
const stubs = stubsAll.slice(0, 30);
const orphans = orphansAll.slice(0, 30);
const broken = brokenAll.slice(0, 30);
const staleAll = getStaleActiveProjects(14);
const stale = staleAll.slice(0, 30);
const BASE_URL = import.meta.env.BASE_URL;

// Growth strip: page count by creation month, last 12 months with data.
// loadAllArticles() is cached module-level, so the second call below is cheap.
const byMonth = new Map<string, number>();
for (const a of loadAllArticles()) {
  const d = (a.created || '').slice(0, 7);
  if (d) byMonth.set(d, (byMonth.get(d) || 0) + 1);
}
const months = [...byMonth.entries()].sort(([x], [y]) => x.localeCompare(y)).slice(-12);
let running = loadAllArticles().length - months.reduce((s, [, n]) => s + n, 0);
const growth = months.map(([m, n]) => ({ m, total: (running += n) }));
const maxTotal = growth.at(-1)?.total || 1;
---
<Base title="Content gaps" description="Stubs, orphans, broken links, and stale projects in WikiLeighs.">
  <h1 class="unlit-title">The unlit sky</h1>
  <p class="unlit-sub">what the vault hasn't finished thinking</p>

  <div class="growth" role="img" aria-label={`Vault growth over 12 months, now ${growth.at(-1)?.total || 0} pages`}>
    {growth.map(g => <div class="bar" style={`height:${Math.round((g.total / maxTotal) * 100)}%`} title={`${g.m}: ${g.total}`} />)}
  </div>

  <section id="stubs" class="gap-panel">
    <div class="gap-title">STUBS · {stubsAll.length} <span>unwritten stars</span></div>
    <p class="gap-note">
      Articles with fewer than 40 non-empty body lines or fewer than 80 words. Sorted by inbound
      link count — the most-linked stubs are the most urgent to fill.
      {stubsAll.length > stubs.length && ` Showing the top ${stubs.length}.`}
    </p>
    {stubs.length === 0 ? (
      <p class="gap-note"><em>No stubs. Vault is looking complete.</em></p>
    ) : stubs.map(s => (
      <div class="gap-row">○ <a href={`${BASE_URL}wiki/${s.slug}`}>{s.title}</a> <span class="gap-meta">{s.inboundCount} inbound · {humanizeType(s.type)}</span></div>
    ))}
  </section>

  <section id="orphans" class="gap-panel">
    <div class="gap-title">ORPHANS · {orphansAll.length} <span>unlinked stars</span></div>
    <p class="gap-note">
      Articles with zero inbound wikilinks across the vault. Either underlinked or truly standalone.
      {orphansAll.length > orphans.length && ` Showing the first ${orphans.length} alphabetically.`}
    </p>
    {orphans.length === 0 ? (
      <p class="gap-note"><em>No orphans.</em></p>
    ) : orphans.map(o => (
      <div class="gap-row">○ <a href={`${BASE_URL}wiki/${o.slug}`}>{o.title}</a> <span class="gap-meta">{humanizeType(o.type)}</span></div>
    ))}
  </section>

  <section id="broken" class="gap-panel">
    <div class="gap-title">BROKEN · {brokenAll.length} <span>pointing at nothing</span></div>
    <p class="gap-note">
      <code>[[Target]]</code> references where no article exists with that title or alias. Top 30 by
      inbound pressure.
    </p>
    {broken.length === 0 ? (
      <p class="gap-note"><em>No broken wikilinks.</em></p>
    ) : broken.map(b => (
      <div class="gap-row">→ <a href={`${BASE_URL}missing?title=${encodeURIComponent(b.target)}`} class="wikilink-broken">{b.target}</a> <span class="gap-meta">{b.sourceCount} source page{b.sourceCount === 1 ? '' : 's'}</span></div>
    ))}
  </section>

  <section id="stale" class="gap-panel">
    <div class="gap-title">STALE · {staleAll.length} <span>gone quiet</span></div>
    <p class="gap-note">
      Projects marked <code>status: active</code> whose <code>updated:</code> date is more than 14 days old.
    </p>
    {stale.length === 0 ? (
      <p class="gap-note"><em>No stale active projects. Everything is moving.</em></p>
    ) : stale.map(p => (
      <div class="gap-row">○ <a href={`${BASE_URL}wiki/${p.slug}`}>{p.title}</a> <span class="gap-meta">updated {p.updated || '—'}</span></div>
    ))}
  </section>
</Base>
