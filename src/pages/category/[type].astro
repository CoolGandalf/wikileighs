---
import Base from '../../layouts/Base.astro';
import { getTypeCounts, getArticlesByType, humanizeType, pluralizeType } from '../../lib/vault';

export async function getStaticPaths() {
  return getTypeCounts().map(tc => ({ params: { type: tc.type } }));
}

const { type } = Astro.params;
const articles = getArticlesByType(type!);
const BASE_URL = import.meta.env.BASE_URL;

// For type=project, build a status-grouped overview as the intro.
const isProjects = type === 'project';

// For type=journal or type=voice-memo, group chronologically by month (newest first).
// Voice-memo titles look like 2026-04-27-151423; sort + group by the leading YYYY-MM-DD.
const isChronological = type === 'journal' || type === 'voice-memo';
type JournalEntry = (typeof articles)[number] & { _date: string; _time: string };
type JournalMonth = { monthKey: string; monthLabel: string; entries: JournalEntry[] };
const journalMonths: JournalMonth[] = [];
if (isChronological) {
  const dated: JournalEntry[] = [];
  for (const a of articles) {
    // Voice-memo slugs are 2026-04-27-151423; older daily journals are 20260416 (compact).
    // Prefer slug (canonical timestamp), fall back to created frontmatter.
    const slug = a.slug || '';
    const created = a.created || '';
    let date = '';
    let time = '';
    let m = /^(\d{4}-\d{2}-\d{2})-(\d{2})(\d{2})(?:(\d{2}))?/.exec(slug);
    if (m) {
      date = m[1];
      time = `${m[2]}:${m[3]}`;
    } else if ((m = /^(\d{4})(\d{2})(\d{2})$/.exec(slug))) {
      date = `${m[1]}-${m[2]}-${m[3]}`;
    } else if ((m = /^(\d{4}-\d{2}-\d{2})/.exec(created))) {
      date = m[1];
    }
    dated.push({ ...a, _date: date, _time: time });
  }
  dated.sort((a, b) => {
    const cmp = b._date.localeCompare(a._date);
    if (cmp !== 0) return cmp;
    return b._time.localeCompare(a._time);
  });
  const monthIndex = new Map<string, JournalMonth>();
  for (const e of dated) {
    const monthKey = e._date.slice(0, 7) || 'undated';
    let group = monthIndex.get(monthKey);
    if (!group) {
      const monthLabel = monthKey === 'undated'
        ? 'Undated'
        : new Date(`${monthKey}-15T12:00:00-04:00`).toLocaleDateString('en-US', {
            month: 'long', year: 'numeric', timeZone: 'America/New_York',
          });
      group = { monthKey, monthLabel, entries: [] };
      monthIndex.set(monthKey, group);
      journalMonths.push(group);
    }
    group.entries.push(e);
  }
}
const STATUS_BUCKETS: Array<{ key: string; label: string; matches: (s: string | null) => boolean }> = [
  { key: 'active',      label: 'Active',         matches: (s) => s === 'active' },
  { key: 'in-progress', label: 'In progress',    matches: (s) => s === 'in-progress' || s === 'in progress' },
  { key: 'paused',      label: 'Paused',         matches: (s) => s === 'paused' || s === 'on-hold' || s === 'on hold' },
  { key: 'planned',     label: 'Planned / Ideas', matches: (s) => s === 'planned' || s === 'idea' || s === 'backlog' },
  { key: 'shipped',     label: 'Shipped / Complete', matches: (s) => s === 'shipped' || s === 'complete' || s === 'completed' || s === 'done' },
  { key: 'archived',    label: 'Archived',       matches: (s) => s === 'archived' || s === 'seasonal' },
  { key: 'other',       label: 'Other / Unstatused', matches: () => true },
];

type StatusBucket = { key: string; label: string; items: typeof articles };
const statusOverview: StatusBucket[] = [];
if (isProjects) {
  const remaining = [...articles];
  for (const bucket of STATUS_BUCKETS) {
    const items: typeof articles = [];
    for (let i = remaining.length - 1; i >= 0; i--) {
      const a = remaining[i];
      const s = (a.status || '').toLowerCase().trim() || null;
      if (bucket.matches(s)) {
        items.push(a);
        remaining.splice(i, 1);
      }
    }
    items.sort((a, b) => {
      const au = a.updated || '';
      const bu = b.updated || '';
      if (au !== bu) return bu.localeCompare(au); // most-recent first
      return a.title.localeCompare(b.title);
    });
    if (items.length) statusOverview.push({ key: bucket.key, label: bucket.label, items });
  }
}

// Flat "recent" order for the Recent/A–Z toggle (non-project, non-chronological
// types). A–Z order reuses `articles` directly — getArticlesByType() already
// sorts non-chronological types by title.
const recentSorted = [...articles].sort((a, b) => {
  const au = a.updated || a.created || '';
  const bu = b.updated || b.created || '';
  if (au !== bu) return bu.localeCompare(au);
  return a.title.localeCompare(b.title);
});

function truncate(s: string, n: number): string {
  if (!s) return '';
  const clean = s.replace(/\s+/g, ' ').trim();
  return clean.length <= n ? clean : clean.slice(0, n - 1).trimEnd() + '…';
}
---
<Base title={pluralizeType(type!)} activeType={type}>
  <article class="article-body">
    <h1 class="cat-title">{pluralizeType(type!)} <span class="gold">{articles.length}</span></h1>

    {isChronological ? (
      journalMonths.map(group => (
        <>
          <div class="bucket-title">{group.monthLabel}</div>
          {group.entries.map(e => (
            <div class="idx-row">
              <a class="idx-title" href={`${BASE_URL}wiki/${e.slug}`}>{e.title}</a>
              <span class="idx-date">{(e._date || '').slice(5)}</span>
              <span class="idx-excerpt">{truncate(e.firstParagraph, 90) || humanizeType(e.type)}</span>
            </div>
          ))}
        </>
      ))
    ) : (
      <>
        <div class="idx-orders">
          <button type="button" class="idx-order active" data-order="recent">recent</button>
          <button type="button" class="idx-order" data-order="az">a–z</button>
        </div>
        <div id="order-recent" class="idx-list">
          {isProjects ? statusOverview.map(bucket => (
            <>
              <div class="bucket-title">{bucket.label} · {bucket.items.length}</div>
              {bucket.items.map(a => (
                <div class="idx-row">
                  <a class="idx-title" href={`${BASE_URL}wiki/${a.slug}`}>{a.title}</a>
                  <span class="idx-date">{(a.updated || a.created || '').slice(5)}</span>
                  <span class="idx-excerpt">{truncate(a.firstParagraph || '', 90)}</span>
                </div>
              ))}
            </>
          )) : recentSorted.map(a => (
            <div class="idx-row">
              <a class="idx-title" href={`${BASE_URL}wiki/${a.slug}`}>{a.title}</a>
              <span class="idx-date">{(a.updated || a.created || '').slice(5)}</span>
              <span class="idx-excerpt">{truncate(a.firstParagraph || '', 90)}</span>
            </div>
          ))}
        </div>
        <div id="order-az" class="idx-list" hidden>
          {articles.map(a => (
            <div class="idx-row">
              <a class="idx-title" href={`${BASE_URL}wiki/${a.slug}`}>{a.title}</a>
              <span class="idx-date">{(a.updated || a.created || '').slice(5)}</span>
              <span class="idx-excerpt">{truncate(a.firstParagraph || '', 90)}</span>
            </div>
          ))}
        </div>
        <script is:inline>
          document.querySelectorAll('.idx-order').forEach(b => b.addEventListener('click', () => {
            document.querySelectorAll('.idx-order').forEach(x => x.classList.toggle('active', x === b));
            document.getElementById('order-recent').hidden = b.dataset.order !== 'recent';
            document.getElementById('order-az').hidden = b.dataset.order !== 'az';
          }));
        </script>
      </>
    )}
  </article>
</Base>
