---
import Base from '../../layouts/Base.astro';
import { getTodayPage, listTodayPageDates } from '../../lib/vault';
import { newYorkDateLabel, newYorkWeekdayShort, getAdjacentTodayDates } from '../../lib/date';

export function getStaticPaths() {
  return listTodayPageDates().map((date) => ({ params: { date } }));
}

const dateStamp = Astro.params.date as string;
const parsed = new globalThis.Date(`${dateStamp}T12:00:00-04:00`);
const page = getTodayPage(parsed);

const weekday = parsed.toLocaleDateString('en-US', { weekday: 'long', timeZone: 'America/New_York' });
const monthDay = parsed.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const headerDate = `${weekday}, ${monthDay}`;
const navDateCaps = newYorkDateLabel(parsed).toUpperCase();
const BASE_URL = import.meta.env.BASE_URL;

// [date].astro had no prev/next navigation at all before this — built here
// on listTodayPageDates() (same source the archive uses) rather than shifting
// the calendar date by one, which would 404 straight into an un-generated
// gap day (the today-cron has missed a handful of days).
const { prev, next } = getAdjacentTodayDates(listTodayPageDates(), dateStamp);
const prevLabel = prev ? newYorkWeekdayShort(prev).toLowerCase() : null;
const nextLabel = next ? newYorkWeekdayShort(next).toLowerCase() : null;
---
<Base title={`Today — ${dateStamp}`} description={`Daily snapshot for ${headerDate}.`}>
  <nav class="today-nav" aria-label="Daily snapshot navigation">
    {prev && (
      <>
        <a href={`${BASE_URL}today/${prev}/`} title={prev}>← {prevLabel}</a>
        {' · '}
      </>
    )}
    <span class="now">{navDateCaps}</span>
    {' · '}
    {next ? (
      <a href={`${BASE_URL}today/${next}/`} title={next}>{nextLabel} →</a>
    ) : (
      <span class="unwritten">tomorrow is unwritten →</span>
    )}
    {' · '}
    <a href={`${BASE_URL}today/archive`}>archive</a>
  </nav>
  {page ? (
    <article class="article-body">
      {page.photo && (
        <div class="today-wash">
          <img src={page.photo} alt={`Today's hero — ${dateStamp}`} loading="lazy" />
          <span class="wash-caption">{page.created || dateStamp}</span>
        </div>
      )}
      <Fragment set:html={page.html} />
    </article>
  ) : (
    <article class="article-body">
      <h1>{headerDate}</h1>
      <p style="color: var(--color-muted);"><em>No snapshot exists for this date.</em></p>
    </article>
  )}
</Base>
