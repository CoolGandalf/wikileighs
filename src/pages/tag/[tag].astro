---
import Base from '../../layouts/Base.astro';
import { loadAllArticles, slugify } from '../../lib/vault';

export async function getStaticPaths() {
  const map = new Map<string, string>();
  for (const a of loadAllArticles()) {
    for (const t of a.tags) {
      const s = slugify(t);
      if (s) map.set(s, t);
    }
  }
  return Array.from(map.entries()).map(([slug, display]) => ({
    params: { tag: slug },
    props: { display },
  }));
}

const { tag } = Astro.params;
const { display } = Astro.props as { display: string };
// Single "recent" order (spec: same flat mono index as categories, one order is
// enough here — no bucket/toggle machinery for tag pages).
const matches = loadAllArticles()
  .filter(a => a.tags.some(t => slugify(t) === tag))
  .sort((a, b) => {
    const au = a.updated || a.created || '';
    const bu = b.updated || b.created || '';
    if (au !== bu) return bu.localeCompare(au);
    return a.title.localeCompare(b.title);
  });
const BASE_URL = import.meta.env.BASE_URL;

function truncate(s: string, n: number): string {
  if (!s) return '';
  const clean = s.replace(/\s+/g, ' ').trim();
  return clean.length <= n ? clean : clean.slice(0, n - 1).trimEnd() + '…';
}
---
<Base title={`#${display}`}>
  <article class="article-body">
    <h1 class="cat-title">#{display} <span class="gold">{matches.length}</span></h1>
    <div class="idx-list">
      {matches.map(a => (
        <div class="idx-row">
          <a class="idx-title" href={`${BASE_URL}wiki/${a.slug}`}>{a.title}</a>
          <span class="idx-date">{(a.updated || a.created || '').slice(5) || '—'}</span>
          <span class="idx-excerpt">{truncate(a.firstParagraph || '', 90)}</span>
        </div>
      ))}
    </div>
  </article>
</Base>
