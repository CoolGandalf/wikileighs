---
import type { Article } from '../lib/vault';
import { isStub } from '../lib/vault';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const show = isStub(article);
---
{show && (
  <div class="stub-line" role="note" aria-label="Stub notice">○ unwritten star — this page is a stub. <span>Ask Giles to expand it.</span></div>
)}
